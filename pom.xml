<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.swiftfaze</groupId>
    <artifactId>Veil</artifactId>
    <version>0.5.0-beta.6</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cucumber.version>7.34.6</cucumber.version>
        <main.class>com.swiftfaze.veil.Main</main.class>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.14.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Acceptance tests (Step 5): runs .feature files from /specs/features via RunCucumberTest -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.18</version>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <!-- .feature files live in /specs/features (single source of truth per the
                 intent -> spec pipeline), copied onto the test classpath so Cucumber's
                 @SelectPackages("features") can discover them. -->
            <testResource>
                <directory>${project.basedir}/specs/features</directory>
                <targetPath>features</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <!-- Unit + acceptance tests (*Test.java, including the Cucumber suite runner) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <!-- Integration tests (*IT.java) only, bound to integration-test/verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Produces target/veil-<version>-app.jar, a single runnable jar with all
                 dependencies bundled, which the Windows installer build (docs/release.md)
                 feeds into jpackage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>app</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Lets `mvn compile exec:java` run the game directly from
                 compiled classes, no packaging or version needed. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <!-- Step 6 (mutation testing): `mvn org.pitest:pitest-maven:mutationCoverage`.
                 Targets the domain/logic classes that have real unit tests; Swing view
                 classes with no meaningful unit coverage (Main, panels that are pure
                 layout/styling, ClassSandbox's own entry point) are excluded rather than left
                 to report a wall of untested surviving mutants. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.17.4</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.swiftfaze.veil.Camera</param>
                        <param>com.swiftfaze.veil.world.*</param>
                        <param>com.swiftfaze.veil.entities.*</param>
                        <param>com.swiftfaze.veil.mods.*</param>
                        <param>com.swiftfaze.veil.ui.EastPanel</param>
                        <param>com.swiftfaze.veil.ui.InventoryPanel</param>
                        <param>com.swiftfaze.veil.input.Keybindings</param>
                        <param>com.swiftfaze.veil.sandbox.ClassSandboxModel</param>
                        <param>com.swiftfaze.veil.sandbox.ClassSandboxPanel</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.swiftfaze.veil.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                    </outputFormats>
                </configuration>
            </plugin>
            <!-- Step 4 code-quality gates: PMD enforces cyclomatic complexity, function
                 length, parameter count, and duplicate-code detection via rulesets/java/design.xml.
                 Bound to verify. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>cpd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnViolation>true</failOnViolation>
                    <linkXRef>false</linkXRef>
                    <includeTests>false</includeTests>
                    <minimumTokens>100</minimumTokens>
                    <!-- Minimal ruleset: ONLY complexity, method length, parameters, and CPD -->
                    <rulesets>
                        <ruleset>${project.basedir}/.pmd-minimal.xml</ruleset>
                    </rulesets>
                    <!-- Exclude pure layout classes from PMD checks -->
                    <excludes>
                        <exclude>**/ui/widget/ButtonWidget.java</exclude>
                        <exclude>**/ui/widget/FocusManager.java</exclude>
                        <exclude>**/ui/widget/TerminalScrollBarUI.java</exclude>
                        <exclude>**/ui/widget/Widget.java</exclude>
                        <exclude>**/ui/NorthPanel.java</exclude>
                        <exclude>**/ui/PlayerInfoPanel.java</exclude>
                        <exclude>**/ui/ResetConfirmationPopup.java</exclude>
                        <exclude>**/ui/SettingsWindow.java</exclude>
                        <exclude>**/ui/SouthPanel.java</exclude>
                        <exclude>**/ui/TerminalPanel.java</exclude>
                        <exclude>**/GameConst.java</exclude>
                        <exclude>**/Positionable.java</exclude>
                        <exclude>**/DrawableAsciiEntity.java</exclude>
                        <exclude>**/exceptions/ModLoadException.java</exclude>
                        <exclude>**/game/GameListener.java</exclude>
                        <exclude>**/sandbox/ClassSandbox.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Step 4 coverage gate: JaCoCo enforces 85% line coverage repo-wide.
                 Bound to verify. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <excludes>
                                        <exclude>com.swiftfaze.veil.ui.widget.ButtonWidget</exclude>
                                        <exclude>com.swiftfaze.veil.ui.widget.FocusManager</exclude>
                                        <exclude>com.swiftfaze.veil.ui.widget.TerminalScrollBarUI</exclude>
                                        <exclude>com.swiftfaze.veil.ui.widget.Widget</exclude>
                                        <exclude>com.swiftfaze.veil.ui.NorthPanel</exclude>
                                        <exclude>com.swiftfaze.veil.ui.PlayerInfoPanel</exclude>
                                        <exclude>com.swiftfaze.veil.ui.ResetConfirmationPopup</exclude>
                                        <exclude>com.swiftfaze.veil.ui.SettingsWindow</exclude>
                                        <exclude>com.swiftfaze.veil.ui.SouthPanel</exclude>
                                        <exclude>com.swiftfaze.veil.ui.TerminalPanel</exclude>
                                        <exclude>com.swiftfaze.veil.GameConst</exclude>
                                        <exclude>com.swiftfaze.veil.Positionable</exclude>
                                        <exclude>com.swiftfaze.veil.DrawableAsciiEntity</exclude>
                                        <exclude>com.swiftfaze.veil.exceptions.ModLoadException</exclude>
                                        <exclude>com.swiftfaze.veil.game.GameListener</exclude>
                                        <exclude>com.swiftfaze.veil.sandbox.ClassSandbox</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
